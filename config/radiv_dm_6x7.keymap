#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LWR 1
#define RSE 2

///* Physical key positions */

#define KEYS_L \
    0 1 2 3 4 5 6 \
    14 15 16 17 18 19 20 \
    28 29 30 31 32 33 34 \
    42 43 44 45 46 47

#define KEYS_R \
    7 8 9 10 11 12 13 \
    21 22 23 24 25 26 27 \
    35 36 37 38 39 40 41 \
    48 49 50 51 52 53

/* Outer thumb keys only */

#define THUMBS \
    54 55 56 57 \
    58 59 60 61* Physical key positions */

#define KEYS_L \
    0 1 2 3 4 5 6 \
    14 15 16 17 18 19 20 \
    28 29 30 31 32 33 34 \
    42 43 44 45 46 47

#define KEYS_R \
    7 8 9 10 11 12 13 \
    21 22 23 24 25 26 27 \
    35 36 37 38 39 40 41 \
    48 49 50 51 52 53

/* Outer thumb keys only */

#define THUMBS \
    54 55 56 57 \
    58 59 60 61* Physical key positions */

#define KEYS_L \
    0 1 2 3 4 5 6 \
    14 15 16 17 18 19 20 \
    28 29 30 31 32 33 34 \
    42 43 44 45 46 47

#define KEYS_R \
    7 8 9 10 11 12 13 \
    21 22 23 24 25 26 27 \
    35 36 37 38 39 40 41 \
    48 49 50 51 52 53

/* Outer thumb keys only */

#define THUMBS \
    54 55 56 57 \
    58 59 60 61


/ {
    behaviors {
      mt_left: mt_left {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "balanced";

        tapping-term-ms = <280>;
        quick-tap-ms = <QUICK_TAP_MS>;

        require-prior-idle-ms = <150>;

        hold-trigger-on-release;

        hold-trigger-key-positions = <KEYS_R THUMBS>;

        bindings = <&kp>, <&kp>;
      };

      mt_right: mt_right {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;

        flavor = "balanced";

        tapping-term-ms = <280>;
        quick-tap-ms = <QUICK_TAP_MS>;

        require-prior-idle-ms = <150>;

        hold-trigger-on-release;

        hold-trigger-key-positions = <KEYS_L THUMBS>;

        bindings = <&kp>, <&kp>;
      };
    };

    macros {
        // Omarchy Menu (super + shift + space)
        menu: menu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LGUI &kp LSHFT>
                ;
        };

        // Omarchy App launcher (super + space)
        app: app {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to Workspace 1 (super + 1)
        wrk1: wrk1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp N1>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to Workspace 2 (super + 2)
        wrk2: wrk2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp N2>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to Workspace 3 (super + 3)
        wrk3: wrk3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp N3>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to Workspace 4 (super + 4)
        wrk4: wrk4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to next workspace (super + TAB)
        nxtwrk: nxtwrk { compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LGUI>
                ;
        };

        // switch to next workspace (super + shift + TAB)
        prvwrk: prvwrk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LGUI &kp LSHFT>
                ;
        };

        // Open files in omarchy (super + shift + F)
        openf: openf{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &kp LSHFT>
                , <&macro_tap &kp F>
                , <&macro_release &kp LGUI &kp LSHFT>
                ;
        };
    };

//    mt {
//        tapping-term-ms = <280>; // default value = 200
//        flavor = "balanced";
//        require-prior-idle-ms = <150>;
//        quick-tap-ms = <175>;
//    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp GRAVE &kp N1          &kp N2          &kp N3           &kp N4           &kp N5 &kp N6                &kp N7   &kp N8  &kp N9            &kp N0            &kp MINUS        &kp EQUAL           &kp BSLH
                &kp TAB   &kp Q           &kp W           &kp E            &kp R            &kp T  &kp LBRC              &kp RBRC &kp Y   &kp U             &kp I             &kp O            &kp P               &tog 2
                &kp ESC   &mt_left LALT A &mt_left LGUI S &mt_left LCTRL D &mt_left LSHFT F &kp G  &kp LBKT              &kp RBKT &kp H   &mt_right RSHFT J &mt_right RCTRL K &mt_right RGUI L &mt_right RALT SEMI &kp SQT
                &kp LSHFT &kp Z           &kp X           &kp C            &kp V            &kp B                                 &kp N   &kp M             &kp COMMA         &kp DOT          &kp FSLH            &trans
                &none     &none           &none           &none                                                                           &none             &none             &none            &none
                                                                           &mo 1  &kp SPACE                              &kp BSPC &kp RET
                                                                           &kp DEL &kp LGUI                              &kp RGUI &wrk3
                                                                           &wrk1                                         &wrk4
            >;
        };

        lower_layer {
            bindings = <
                &trans  &trans &trans &trans &trans &trans &trans             &kp F1 &kp F2   &trans   &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_CLR &trans
                &trans  &trans &kp N7 &kp N8 &kp N9 &trans &trans             &trans &trans   &trans   &trans         &trans       &trans     &trans
                &trans  &trans &kp N4 &kp N5 &kp N6 &trans &trans             &trans &kp LEFT &kp DOWN &kp UP         &kp RIGHT    &trans     &trans
                &trans  &trans &kp N1 &kp N2 &kp N3 &trans                           &trans   &trans   &trans         &trans       &trans     &trans
                &trans  &trans &kp N0 &trans                                                           &trans         &trans       &trans     &trans
                                                    &trans &trans             &trans &trans
                                                    &trans &trans             &trans &trans
                                                    &trans                           &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp GRAVE &kp J     &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      &none &none &none &none &none &none &none
                &kp Y     &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T       &none &none &none &none &none &none &trans
                &kp H     &kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G       &none &none &none &none &none &none &none
                &kp N     &kp LSHFT &kp Z  &kp X  &kp C  &kp V                    &none &none &none &none &none &none
                &none     &none     &none  &none                                              &none &none &none &none
                                                         &none  &kp SPACE   &none &none
                                                         &none  &kp M       &none &none
                                                         &none                    &none
            >;
        };

        
    };
};
